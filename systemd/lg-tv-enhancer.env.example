# Template for /etc/default/lg-tv-enhancer (root-owned, chmod 600, out of git).
#   sudo cp lg-tv-enhancer.env.example /etc/default/lg-tv-enhancer
#   sudo chmod 600 /etc/default/lg-tv-enhancer

# LG TV's LAN IP, held steady by a DHCP reservation on your router. Prefer the
# reserved IP over a DNS name that tracks the lease: the name stops resolving
# once the lease ages out, and it can do that while the TV is perfectly
# reachable, stranding the daemon in a reconnect loop. Reserve both the wired
# and Wi-Fi MACs if the TV moves between them. Set this to that LAN address.
LGTV_HOST=

# webOS pairing key. Reuse tv-dsp's key (same TV, same client library):
#   grep TVDSP_TV_KEY /etc/default/tv-dsp
# or, after a fresh interactive pairing:
#   sqlite3 ~/.aiopylgtv.sqlite 'select value from unnamed'
LGTV_KEY=

# Location for sunset/sunrise. Rough coordinates are fine — a whole degree of
# error moves the transitions by only a few minutes.
LGTV_LAT=40.7128
LGTV_LON=-74.0060

# How often to retry while the TV is unreachable / a write is pending (seconds).
#LGTV_POLL_SECS=60

# --- ISF preset keeper (lg-tv-preset.service) ---------------------------------
# Presets are recognized by their picture-settings fingerprint
# "contrast,backlight,brightness" (the C9 won't report pictureMode by name).
# The C9 stores picture settings PER INPUT, so a preset can read different
# values on different inputs (e.g. an HDMI/cable input vs. the built-in apps).
# List every fingerprint for a preset, ';'-separated. Re-derive with:
#   /home/pi/lg-tv-enhancer/venv/bin/python src/preset_daemon.py --listen
# Turn OFF Energy Saving / OLED-Light auto-dimming first, or backlight drifts
# and the fingerprint won't hold still (also better for calibrated ISF modes).
#LGTV_PRESET_BRIGHT=90,90,65;90,100,60
#LGTV_PRESET_DARK=85,10,50;85,28,50

# pictureMode value written to restore each preset.
#LGTV_MODE_BRIGHT=expert1
#LGTV_MODE_DARK=expert2

# Seconds after an app/input change to still attribute a mode change to it.
#LGTV_SETTLE_SECS=3

# --- Ambient-light hook (optional; runs inside lg-tv-preset.service) -----------
# Off unless a source is named. When on, room brightness auto-picks ISF
# Bright/Dark and the keeper enforces it — one writer of pictureMode. A manual
# Bright/Dark rides until the light next crosses a band. Dolby Vision and any
# unrecognized preset are left alone.
#   bh1750  BH1750FVI over I2C (see the README ambient-light section)
#   file    read lux from a file (a Home Assistant / MQTT bridge, or testing)
#   none    disabled (default)
#LGTV_LUX_SOURCE=bh1750
#LGTV_LUX_ADDRESS=0x23          # bh1750 only; 0x5C if ADDR is tied high
#LGTV_LUX_FILE=/run/lux         # file source only

# Band thresholds (lux) and debounce. Defaults are mount-specific — re-measure if
# you move the sensor, since a sensor that sees less light needs lower edges, not
# a wider deadband. The deadband straddles the evening-dim dwell so it flips to
# Dark only once light is genuinely gone; the hold rejects transients (shadow,
# headlight, phone glance) without lag.
#
# Shortening HOLD alone does nothing: a commit needs two consecutive agreeing
# samples, so response time is floored by POLL. Shorten both, and expect brief
# transients to start committing that the longer hold used to filter out.
#
# Uncomment BOTH edges even when one matches its default: together they are a
# deadband, and leaving one implicit means half its width is invisible here and
# never gets calibrated. With the bh1750 source, land each edge between two
# reportable readings — H-res reports raw/1.2, so only multiples of 0.833 lux
# can occur. An edge set just under a value the room actually rests at has no
# margin at all, since the next reading down is a full step away.
#LGTV_LUX_DARK_BELOW=1.0        # flip to Dark under this
#LGTV_LUX_BRIGHT_ABOVE=3.0      # flip to Bright over this
#LGTV_LUX_HOLD_SECS=30          # a new band must hold this long to commit
#LGTV_LUX_POLL_SECS=30          # seconds between sensor reads
